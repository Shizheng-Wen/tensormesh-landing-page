---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import '../styles/global.css';
import { site, links } from '../data/site';
import TopNav from '../components/TopNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
} = Astro.props;

// The homepage keeps the full SEO title; subpages get "Page · TensorMesh".
const pageTitle = title === site.seoTitle ? site.seoTitle : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${site.domain}`);

// Structured data so search engines understand what TensorMesh is (an
// open-source scientific-computing library, not the unrelated AI-inference
// company with a similar name).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TensorMesh',
  alternateName: 'tensormesh-fem',
  description: site.seoDescription,
  url: `https://${site.domain}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [links.github, links.docs],
  author: {
    '@type': 'Organization',
    name: 'CAMLab, ETH Zürich',
    url: 'https://camlab.ethz.ch/',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-ink">
    <TopNav />
    <main class="flex-1">
      <slot />
    </main>

    <script>
      // Reveal-on-scroll. The `js` root class gates the initial hidden state
      // (see global.css) so content is never hidden when JS doesn't run.
      document.documentElement.classList.add('js');

      const targets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
