---
import { site, footerLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-surface-alt">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <img
          src="/assets/logo.png"
          alt="TensorMesh"
          width="2135"
          height="689"
          class="h-9 w-auto"
        />
        <p class="mt-3 text-sm text-muted leading-relaxed">
          PyTorch-native finite element library, built at ETH&nbsp;Zürich CAMLab.
        </p>
      </div>

      {footerLinks.map((group) => (
        <div>
          <h3 class="text-sm font-semibold text-ink">{group.heading}</h3>
          <ul class="mt-3 space-y-2">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-muted hover:text-tmblue transition"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 flex flex-col sm:flex-row justify-between gap-3 text-sm text-muted">
      <span>© {year} TensorMesh Contributors · Apache 2.0 License</span>
      <span>{site.domain}</span>
    </div>
  </div>
</footer>
