---
import { getStarted } from '../data/site';
---

<section class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        Get started
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-muted">
        From <span class="font-mono text-sm">pip install</span> to a solved
        Poisson problem in under a minute.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {getStarted.map((step, i) => (
        <div
          class="flex flex-col rounded-2xl border border-slate-200 bg-surface-alt p-7 hover:border-tmteal/40 transition"
        >
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-tmteal text-white text-xs font-bold"
            >
              {i + 1}
            </span>
            <h3 class="text-lg font-semibold text-ink">{step.label}</h3>
          </div>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            {step.description}
          </p>

          {step.command && (
            <pre class="mt-4 overflow-x-auto rounded-md bg-ink px-4 py-3 text-xs font-mono text-white"><code><span class="text-tmteal select-none">$ </span>{step.command}</code></pre>
          )}

          <a
            href={step.href}
            class="mt-auto pt-5 text-sm font-semibold text-tmblue hover:text-tmteal transition"
          >
            {step.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
