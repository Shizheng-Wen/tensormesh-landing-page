---
import { communityChannels, links } from '../data/site';

const channelIconPaths: Record<string, string> = {
  discord:
    'M19.27 5.33A19.4 19.4 0 0 0 14.5 4l-.21.44a14.7 14.7 0 0 0-4.59 0L9.5 4a19.4 19.4 0 0 0-4.77 1.33A20.4 20.4 0 0 0 2 14.97 19.9 19.9 0 0 0 7.71 18l.66-1.04A12.9 12.9 0 0 1 6.5 16c.15-.12.3-.24.43-.37a13.5 13.5 0 0 0 10.14 0c.14.13.28.25.43.37a12.9 12.9 0 0 1-1.88.95L16.29 18A19.9 19.9 0 0 0 22 14.97a20.4 20.4 0 0 0-2.73-9.64zM9 13.6a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33zm6 0a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33z',
  discussions:
    'M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-2.5L9 17v-4H5a2 2 0 0 1-2-2V5z M21 9v6a2 2 0 0 1-2 2h-3l-3.5 4v-4',
  issues:
    'M12 9v3m0 4h.01M5.07 19h13.86a2 2 0 0 0 1.74-3L13.74 4a2 2 0 0 0-3.48 0L3.34 16a2 2 0 0 0 1.73 3z',
};
---

<section class="bg-surface-alt py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        Join the community
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-muted">
        Get help, share what you build, and keep up with what is coming next.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {communityChannels.map((c) => (
        <a
          href={c.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-tmblue/50 hover:shadow-md transition"
        >
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-tmblue-soft text-tmblue group-hover:bg-tmblue group-hover:text-white transition">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={channelIconPaths[c.icon]} />
              </svg>
            </span>
            <h3 class="text-base font-semibold text-ink">{c.label}</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted">{c.description}</p>
        </a>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-muted">
      Or reach the team directly at
      <a
        href={links.email}
        class="font-medium text-tmblue hover:text-tmteal transition"
      >tensormesh.dev@gmail.com</a>.
    </p>
  </div>
</section>
