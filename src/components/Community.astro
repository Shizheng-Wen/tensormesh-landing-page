---
import { communityChannels, links } from '../data/site';

// SVG path data for each channel's icon. Discord uses the real brand mark;
// Discussions uses a chat-bubble; Issues uses GitHub's Octocat silhouette.
const channelIconPaths: Record<string, string> = {
  discord:
    'M19.27 5.33A19.4 19.4 0 0 0 14.5 4l-.21.44a14.7 14.7 0 0 0-4.59 0L9.5 4a19.4 19.4 0 0 0-4.77 1.33A20.4 20.4 0 0 0 2 14.97 19.9 19.9 0 0 0 7.71 18l.66-1.04A12.9 12.9 0 0 1 6.5 16c.15-.12.3-.24.43-.37a13.5 13.5 0 0 0 10.14 0c.14.13.28.25.43.37a12.9 12.9 0 0 1-1.88.95L16.29 18A19.9 19.9 0 0 0 22 14.97a20.4 20.4 0 0 0-2.73-9.64zM9 13.6a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33zm6 0a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33z',
  discussions:
    'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
};

// Discord and Discussions are stroke-based; Issues uses GitHub's filled
// Octocat mark, so it needs its own render branch.
const githubMark = 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z';
---

<section id="community" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <!--
      One large rounded card containing both columns. Background is a soft
      diagonal gradient from cool (tmblue tint) to warm (peach/cream).
    -->
    <div
      class="relative overflow-hidden rounded-3xl border border-slate-200/70 bg-gradient-to-br from-tmblue-soft via-white to-orange-50 p-8 sm:p-12 shadow-sm"
      data-reveal
    >
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
        <!-- ============ Left column ============ -->
        <div class="flex flex-col">
          <!-- Pill -->
          <span
            class="inline-flex items-center gap-2 self-start rounded-full border border-tmblue/20 bg-white/70 px-3 py-1 text-xs font-medium text-tmblue backdrop-blur"
          >
            <span class="h-2 w-2 rounded-full bg-tmblue animate-pulse"></span>
            Open community · Apache 2.0
          </span>

          <!-- Two-line heading -->
          <h2 class="mt-6 text-3xl sm:text-4xl font-bold tracking-tight text-ink leading-tight">
            <span class="inline-flex items-center gap-2 text-ink">
              Stuck on a PDE?
              <svg class="h-7 w-7 text-tmblue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            </span>
            <br />
            <span class="text-tmblue">Ask the maintainers.</span>
          </h2>

          <!-- Body -->
          <p class="mt-5 text-base leading-relaxed text-muted">
            Pick a channel on the right, or email Shizheng Wen at
            <a
              href={links.email}
              class="font-semibold text-tmblue hover:text-tmteal transition"
            >shizheng.wen@sam.math.ethz.ch</a> for research collaborations.
          </p>

          <!-- Bottom badges -->
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3.5 py-1.5 text-xs font-medium text-ink shadow-sm backdrop-blur">
              <svg class="h-4 w-4 text-tmteal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
              Maintainers reply here
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3.5 py-1.5 text-xs font-medium text-ink shadow-sm backdrop-blur">
              <svg class="h-4 w-4 text-tmblue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
              Researchers welcome
            </span>
          </div>
        </div>

        <!-- ============ Right column: 3 channel rows ============ -->
        <div class="flex flex-col gap-3">
          {communityChannels.map((c) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-white/80 bg-white/80 px-5 py-4 shadow-sm backdrop-blur transition hover:bg-white hover:border-tmblue/30 hover:shadow-md"
            >
              <!-- Icon tile -->
              <span class={`inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ${c.iconBg} ${c.iconColor}`}>
                {c.icon === 'issues' ? (
                  <svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d={githubMark} clip-rule="evenodd" />
                  </svg>
                ) : (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill={c.icon === 'discord' ? 'currentColor' : 'none'}
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={channelIconPaths[c.icon]} />
                  </svg>
                )}
              </span>

              <!-- Title + subtitle -->
              <div class="min-w-0 flex-1">
                <div class="text-base font-semibold text-ink">{c.label}</div>
                <div class="text-sm text-muted">{c.subtitle}</div>
              </div>

              <!-- Arrow -->
              <svg
                class="h-5 w-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-tmblue"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M7.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 10 7.293 6.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
