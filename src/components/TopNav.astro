---
import { links } from '../data/site';

// Anchor links — order matters (left-to-right in nav). Each href targets a
// section[id="..."] elsewhere on the page. Mobile hides this list and falls
// back to logo + 2 buttons only.
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Code', href: '#code' },
  { label: 'Benchmarks', href: '#benchmarks' },
  { label: 'Examples', href: '#examples' },
  { label: 'Community', href: '#community' },
];
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/75 backdrop-blur supports-[backdrop-filter]:bg-white/60"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-6">
    <!-- Logo / back-to-top -->
    <a
      href="#top"
      class="flex items-center gap-2 shrink-0 transition hover:opacity-80"
      aria-label="TensorMesh — back to top"
    >
      <img src="/assets/logo.png" alt="TensorMesh" class="h-7 w-auto" />
    </a>

    <!-- Center anchor links (md+) -->
    <ul class="hidden md:flex items-center gap-7 text-sm font-medium text-muted">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="hover:text-tmblue transition">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right CTAs -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md bg-ink px-3 py-1.5 text-xs font-semibold text-white hover:bg-tmblue transition"
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" clip-rule="evenodd" />
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <a
        href={links.discord}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join us on Discord"
        title="Join us on Discord"
        class="inline-flex items-center justify-center rounded-md bg-[#5865F2] p-1.5 text-white hover:bg-[#4752C4] transition"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.27 5.33A19.4 19.4 0 0 0 14.5 4l-.21.44a14.7 14.7 0 0 0-4.59 0L9.5 4a19.4 19.4 0 0 0-4.77 1.33A20.4 20.4 0 0 0 2 14.97 19.9 19.9 0 0 0 7.71 18l.66-1.04A12.9 12.9 0 0 1 6.5 16c.15-.12.3-.24.43-.37a13.5 13.5 0 0 0 10.14 0c.14.13.28.25.43.37a12.9 12.9 0 0 1-1.88.95L16.29 18A19.9 19.9 0 0 0 22 14.97a20.4 20.4 0 0 0-2.73-9.64zM9 13.6a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33zm6 0a1.66 1.66 0 1 1 0-3.33 1.66 1.66 0 0 1 0 3.33z"/>
        </svg>
      </a>
      <a
        href={links.docs}
        class="inline-flex items-center rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink hover:border-tmblue hover:text-tmblue transition"
      >
        Docs
      </a>
    </div>
  </nav>
</header>
