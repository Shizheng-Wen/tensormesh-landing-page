---
import { gallery } from '../data/site';
---

<section id="gallery" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center" data-reveal>
      <span class="eyebrow">Gallery</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        See it in action
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-muted">
        Real outputs from the example gallery — meshes, fields, and animations
        rendered straight from TensorMesh.
      </p>
    </div>

    <!--
      Bento grid: `wide` items span two columns and are reserved for the
      panoramic multi-panel figures (aspect ≥ 2:1), so nothing drowns in
      letterbox padding. Image wells share a fixed height, keeping every
      row aligned regardless of span.
    -->
    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-stagger>
      {gallery.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-surface-alt hover:border-tmblue/50 hover:shadow-lg transition',
            item.wide && 'sm:col-span-2',
          ]}
        >
          <div class="relative h-44 sm:h-48 overflow-hidden bg-white">
            <img
              src={item.src}
              alt={item.title}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-contain p-2 transition duration-300 group-hover:scale-[1.03]"
            />
            {item.tag && (
              <span class="absolute top-3 left-3 rounded-full border border-slate-200/80 bg-white/85 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted backdrop-blur">
                {item.tag}
              </span>
            )}
            {item.kind === 'animation' && (
              <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-white backdrop-blur">
                <span class="h-1.5 w-1.5 rounded-full bg-tmteal animate-pulse"></span>
                Animation
              </span>
            )}
          </div>
          <div class="flex-1 border-t border-slate-200 bg-white p-5">
            <h3 class="text-base font-semibold text-ink group-hover:text-tmblue transition">
              {item.title}
            </h3>
            <p class="mt-1 text-sm text-muted">{item.caption}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
