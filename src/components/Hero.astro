---
import {
  site,
  heroPrimaryCTAs,
  heroCommandCTAs,
  heroRelease,
  heroStats,
} from '../data/site';
---

<section id="top" class="relative overflow-hidden isolate">
  <!--
    Layered background:
      1. base white-to-slate vertical gradient + two radial brand glows (CSS)
      2. live animated triangular mesh on <canvas> — nodes drift slowly and a
         faint traveling wave tints the elements (drawn by the script below;
         static single frame under prefers-reduced-motion)
      3. bottom fade so the mesh dissolves into the next section
  -->
  <div
    class="absolute inset-0 -z-10"
    style="background:
      radial-gradient(60% 50% at 18% 12%, rgba(91, 110, 232, 0.18), transparent 65%),
      radial-gradient(55% 50% at 88% 28%, rgba(20, 155, 142, 0.18), transparent 65%),
      linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);"
  ></div>
  <canvas
    id="hero-mesh"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <!-- Top fade so the mesh dissolves into the next section -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-32 -z-10"
    style="background: linear-gradient(180deg, transparent, #FFFFFF);"
  ></div>

  <div class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24 sm:pb-28 text-center">
    <!-- Release badge -->
    <a
      href={heroRelease.href}
      target="_blank"
      rel="noopener noreferrer"
      class="group mb-10 inline-flex max-w-full items-center gap-2 rounded-full border border-tmblue/25 bg-white/80 py-1.5 pl-2 pr-3.5 text-xs sm:text-sm shadow-sm backdrop-blur transition hover:border-tmblue/50 hover:shadow"
    >
      <span class="rounded-full bg-tmblue px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white">
        {heroRelease.version}
      </span>
      <span class="truncate font-medium text-muted group-hover:text-ink transition">
        {heroRelease.summary}
      </span>
      <svg class="h-3.5 w-3.5 shrink-0 text-tmblue transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M7.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 10 7.293 6.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>

    <h1 class="sr-only">
      TensorMesh — PyTorch-native finite element (FEM) library
    </h1>
    <img
      src="/assets/logo.png"
      alt="TensorMesh"
      width="2135"
      height="689"
      class="mx-auto w-full max-w-sm sm:max-w-md md:max-w-xl h-auto"
    />

    <p
      class="mx-auto mt-10 max-w-3xl text-lg sm:text-xl leading-relaxed text-muted"
    >
      {site.tagline}
    </p>

    <!-- Row 1: destination buttons -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {heroPrimaryCTAs.map((cta) => {
        if (cta.kind === 'github') {
          return (
            <a
              href={cta.href}
              class="inline-flex items-center gap-2 rounded-lg bg-ink px-6 py-3 text-sm font-semibold tracking-wide text-white shadow-sm hover:bg-tmblue transition"
            >
              <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" clip-rule="evenodd" />
              </svg>
              {cta.label}
            </a>
          );
        }
        return (
          <a
            href={cta.href}
            class="inline-flex items-center gap-2 rounded-lg border border-tmblue bg-white px-6 py-3 text-sm font-semibold tracking-wide text-tmblue shadow-sm hover:bg-tmblue hover:text-white transition"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4v16a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8l-5-5H5a1 1 0 0 0-1 1z"/>
              <polyline points="14 3 14 8 19 8"/>
              <line x1="8" y1="13" x2="16" y2="13"/>
              <line x1="8" y1="17" x2="13" y2="17"/>
            </svg>
            {cta.label}
          </a>
        );
      })}
    </div>

    <!-- Row 2: command-line snippets (click to copy) -->
    <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
      {heroCommandCTAs.map((cta) => (
        <button
          type="button"
          data-copy={cta.command}
          aria-label={`Copy: ${cta.command}`}
          class="copy-btn group inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white/70 backdrop-blur px-4 py-2.5 font-mono text-xs sm:text-sm text-ink shadow-sm hover:border-tmteal hover:text-tmteal transition cursor-pointer"
        >
          <span class="text-tmteal select-none">$</span>
          <span data-copy-text class="truncate max-w-[16rem] sm:max-w-none">{cta.command}</span>
          <!-- Copy icon (shown by default), check icon (shown after copy) -->
          <svg data-copy-icon class="h-3.5 w-3.5 text-muted group-hover:text-tmteal transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg data-check-icon class="hidden h-3.5 w-3.5 text-tmteal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      ))}
    </div>

    <!-- Quick-fact strip -->
    <dl class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-y-8 sm:grid-cols-4 sm:divide-x sm:divide-slate-200/80">
      {heroStats.map((s) => (
        <div class="flex flex-col-reverse items-center gap-1 px-4">
          <dt class="text-xs font-medium text-muted">{s.label}</dt>
          <dd
            class="text-2xl sm:text-3xl font-bold tracking-tight text-ink tabular-nums"
            data-count={s.value}
          >
            {s.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  // Click-to-copy for command snippets. Falls back gracefully if the
  // Async Clipboard API is unavailable (e.g. non-secure context).
  document.querySelectorAll<HTMLButtonElement>('button.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      const label = btn.querySelector<HTMLElement>('[data-copy-text]');
      const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]');
      const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]');
      if (!label || !copyIcon || !checkIcon) return;

      const originalText = label.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Fallback: select-and-execCommand for older browsers
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch {}
        document.body.removeChild(ta);
      }

      label.textContent = 'Copied!';
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(() => {
        label.textContent = originalText;
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 1500);
    });
  });
</script>

<script>
  // ------------------------------------------------------------------
  // Live triangular-mesh background.
  //
  // A jittered equilateral lattice (so the triangulation is known from
  // the lattice topology — no Delaunay needed). Each node drifts on a
  // slow per-node Lissajous orbit, and elements are tinted by a faint
  // traveling wave field, blending the two brand colors. Runs at ~30fps,
  // only while the hero is on screen; prefers-reduced-motion gets a
  // single static frame.
  // ------------------------------------------------------------------
  const canvas = document.getElementById('hero-mesh') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    interface Node {
      bx: number; by: number;   // base (lattice + jitter) position
      amp: number; ph: number; sp: number; // drift amplitude / phase / speed
      x: number; y: number;     // current position
    }

    let nodes: Node[] = [];
    let tris: [number, number, number][] = [];
    let W = 0;
    let H = 0;

    const build = () => {
      const rect = canvas.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      nodes = [];
      tris = [];
      const spacing = Math.max(64, Math.min(104, W / 13));
      const rowH = spacing * 0.866;
      const cols = Math.ceil(W / spacing) + 3;
      const rows = Math.ceil(H / rowH) + 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const bx = (c - 1) * spacing + (r % 2 ? spacing * 0.5 : 0);
          const by = r * rowH;
          nodes.push({
            bx: bx + (Math.random() - 0.5) * spacing * 0.36,
            by: by + (Math.random() - 0.5) * rowH * 0.36,
            amp: 5 + Math.random() * 7,
            ph: Math.random() * Math.PI * 2,
            sp: 0.35 + Math.random() * 0.4,
            x: 0,
            y: 0,
          });
        }
      }
      for (let r = 0; r < rows - 1; r++) {
        for (let c = 0; c < cols - 1; c++) {
          const a = r * cols + c;
          const b = a + 1;
          const d = a + cols;
          const e = d + 1;
          if (r % 2 === 0) tris.push([a, b, d], [b, e, d]);
          else tris.push([a, b, e], [a, e, d]);
        }
      }
    };

    const BLUE = [91, 110, 232];
    const TEAL = [20, 155, 142];

    const draw = (tms: number) => {
      const t = tms * 0.001;
      ctx.clearRect(0, 0, W, H);
      for (const n of nodes) {
        n.x = n.bx + n.amp * Math.sin(t * n.sp + n.ph);
        n.y = n.by + n.amp * Math.cos(t * n.sp * 0.85 + n.ph * 1.7);
      }
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(100, 116, 139, 0.13)';
      for (const [i0, i1, i2] of tris) {
        const p0 = nodes[i0];
        const p1 = nodes[i1];
        const p2 = nodes[i2];
        const cx = (p0.x + p1.x + p2.x) / 3;
        const cy = (p0.y + p1.y + p2.y) / 3;
        // Slow traveling wave; s ∈ [0, 1] blends blue → teal.
        const s = 0.5 + 0.5 * Math.sin(cx * 0.006 + cy * 0.004 - t * 0.8);
        const cr = Math.round(BLUE[0] + (TEAL[0] - BLUE[0]) * s);
        const cg = Math.round(BLUE[1] + (TEAL[1] - BLUE[1]) * s);
        const cb = Math.round(BLUE[2] + (TEAL[2] - BLUE[2]) * s);
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.closePath();
        ctx.fillStyle = `rgba(${cr}, ${cg}, ${cb}, ${(0.045 + 0.085 * s).toFixed(3)})`;
        ctx.fill();
        ctx.stroke();
      }
    };

    let raf = 0;
    let last = 0;
    let running = false;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < 33) return; // ~30fps is plenty for an ambient effect
      last = now;
      draw(now);
    };
    const start = () => {
      if (!running) {
        running = true;
        raf = requestAnimationFrame(loop);
      }
    };
    const stop = () => {
      if (running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    };

    build();
    draw(0);

    if (!prefersReduced) {
      // Animate only while the hero is actually visible.
      const io = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0 },
      );
      io.observe(canvas);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        draw(performance.now());
      }, 150);
    });
  }
</script>

<script>
  // Count-up animation for the hero quick-fact strip. The markup already
  // contains the final value, so with no JS (or reduced motion) nothing
  // is lost — the numbers are simply static.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('dd[data-count]');

  if (!reduced && 'IntersectionObserver' in window && counters.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const match = (el.dataset.count ?? '').match(/^(\d+)(.*)$/);
          if (!match) continue;
          const target = parseInt(match[1], 10);
          const suffix = match[2];
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - t0) / 1100);
            const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
            el.textContent = Math.round(eased * target) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((el) => io.observe(el));
  }
</script>
