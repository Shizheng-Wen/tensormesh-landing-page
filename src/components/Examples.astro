---
import { exampleCategories, links } from '../data/site';

// One SVG glyph per category. Kept inline so the section renders with zero
// network requests beyond the page itself.
const categoryIconPaths: Record<string, string> = {
  // Stack / layers — fundamentals
  basics: 'M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  // Grid / scalar field — Poisson
  poisson: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  // Radiating waves — diffusion
  diffusion: 'M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4M12 3v2m0 14v2M18.4 5.6 17 7m-10 10-1.4 1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  // Sine wave — wave equation
  wave: 'M2 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0',
  // Droplet / flow — fluid
  fluid: 'M12 2.5c-3.5 5-7 9-7 13a7 7 0 0 0 14 0c0-4-3.5-8-7-13zM9 16a3 3 0 0 0 3 3',
  // Block / spring — solid mechanics
  solid: 'M4 7h16v10H4zM8 7v10M12 7v10M16 7v10',
  // Database stack — dataset
  dataset: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6',
  // Network nodes — distributed
  distributed: 'M5 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM7 6.5 17 6.5M6.5 7l5 11M17.5 7l-5 11',
  // Horseshoe magnet — magnetostatics
  magnetostatics: 'M6 3H3v7a9 9 0 0 0 18 0V3h-3v7a6 6 0 0 1-12 0z M3 7h3 M18 7h3',
  // Target / crosshair — inverse design (identification & optimization)
  inverse: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM12 11a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  // Small neural net — physics-informed learning
  physics: 'M5 5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM6.7 4l4 4M6.7 16l4-4M13.5 9.5l4-3.5M13.5 11l4 5',
};
---

<section id="examples" class="bg-surface-alt py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center" data-reveal>
      <span class="eyebrow">Learn by example</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        50+ runnable examples
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-muted">
        Eleven problem categories — every script ships with the repo, and every
        rendered result lives in the docs.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-stagger>
      {exampleCategories.map((cat) => (
        <a
          href={cat.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 hover:border-tmblue/50 hover:shadow-md transition"
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-tmteal-soft text-tmteal group-hover:bg-tmteal group-hover:text-white transition">
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={categoryIconPaths[cat.icon]} />
              </svg>
            </span>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-muted">
              {cat.count}
            </span>
          </div>

          <h3 class="mt-4 text-base font-semibold text-ink group-hover:text-tmblue transition">
            {cat.label}
          </h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            {cat.description}
          </p>

          <span class="mt-auto pt-4 inline-flex items-center text-xs font-semibold text-tmblue group-hover:text-tmteal transition">
            View
            <svg class="ml-1 h-3.5 w-3.5 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 10 7.293 6.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href={links.examples}
        class="inline-flex items-center gap-1 text-sm font-semibold text-tmblue hover:text-tmteal transition"
      >
        Open the full example gallery →
      </a>
    </div>
  </div>
</section>
