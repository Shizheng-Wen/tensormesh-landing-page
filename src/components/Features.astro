---
import { features } from '../data/site';

// Map icon keys to inline SVG paths (Heroicons / Lucide style, 24x24, stroke).
// Order matches the visual top-to-bottom of the cards for easy cross-reference.
const iconPaths: Record<string, string> = {
  gpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2zM9 9h6v6H9z',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
  terminal: 'M4 17l6-6-6-6M12 19h8',
  elements: 'M12 2 3 7v10l9 5 9-5V7l-9-5zM3 7l9 5 9-5M12 12v10',
  solvers: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  python: 'm8 6-6 6 6 6M16 6l6 6-6 6',
};
---

<section id="features" class="bg-surface-alt py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center" data-reveal>
      <span class="eyebrow">Core capabilities</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        Why <span class="text-tmblue">Tensor</span><span class="text-tmteal">Mesh</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-muted">
        Built for the workflow where finite elements meet deep learning — without
        sacrificing the speed and accuracy you expect from a real FEM library.
      </p>
    </div>

    <!--
      Unboxed layout: no per-feature cards — just an icon tile beside the
      text, with generous whitespace. Icon tint alternates blue/teal so the
      grid doesn't read as a single monochrome block.
    -->
    <div
      class="mt-16 grid grid-cols-1 gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal
      data-reveal-stagger
    >
      {features.map((f, i) => (
        <div class="group flex items-start gap-4">
          <span
            class={`mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition ${
              i % 2 === 0
                ? 'bg-tmblue-soft text-tmblue group-hover:bg-tmblue group-hover:text-white'
                : 'bg-tmteal-soft text-tmteal group-hover:bg-tmteal group-hover:text-white'
            }`}
          >
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={iconPaths[f.icon]} />
            </svg>
          </span>
          <div>
            <h3 class="text-base font-semibold text-ink">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{f.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
